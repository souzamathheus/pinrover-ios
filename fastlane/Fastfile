default_platform(:ios)

PROJECT = "ios/App/App.xcodeproj"

platform :ios do
  desc "Build the Capacitor app and upload it to TestFlight"
  lane :beta do
    key_path = File.expand_path("../asc_key.p8", __dir__)
    File.write(key_path, ENV.fetch("ASC_KEY_P8"))

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path
    )

    # Next build number = latest on TestFlight + 1 (1 if the app has no builds yet).
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: "com.pinrover.app", initial_build_number: 0)
    increment_build_number(xcodeproj: PROJECT, build_number: latest + 1)
    increment_version_number(xcodeproj: PROJECT, version_number: ENV.fetch("APP_VERSION", "1.0.0"))

    # Automatic signing with the App Store Connect API key (cloud-managed certificates).
    auth = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{key_path}",
      "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
    ].join(" ")

    build_app(
      project: PROJECT,
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} CODE_SIGN_STYLE=Automatic #{auth}",
      export_xcargs: auth
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
  end
end
