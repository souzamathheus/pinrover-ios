default_platform(:ios)

PROJECT = "ios/App/App.xcodeproj"

BUNDLE_ID = "com.pinrover.app"

platform :ios do
  desc "Register the bundle ID (idempotent) via the App Store Connect API"
  lane :register do
    key_path = File.expand_path("../asc_key.p8", __dir__)
    File.write(key_path, ENV.fetch("ASC_KEY_P8"))
    app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"), key_filepath: key_path)

    existing = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
    if existing
      UI.success("Bundle ID #{BUNDLE_ID} already registered (#{existing.id})")
    else
      created = Spaceship::ConnectAPI::BundleId.create(name: "PinRover", platform: "IOS", identifier: BUNDLE_ID)
      UI.success("Registered bundle ID #{BUNDLE_ID} (#{created.id})")
    end
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
  end

  desc "Build the Capacitor app and upload it to TestFlight"
  lane :beta do
    key_path = File.expand_path("../asc_key.p8", __dir__)
    File.write(key_path, ENV.fetch("ASC_KEY_P8"))

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path
    )

    # Next build number = latest on TestFlight + 1 (1 if the app has no builds yet).
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID, initial_build_number: 0)
    increment_build_number(xcodeproj: PROJECT, build_number: latest + 1)
    increment_version_number(xcodeproj: PROJECT, version_number: ENV.fetch("APP_VERSION", "1.0.0"))

    team = ENV.fetch("APPLE_TEAM_ID")
    auth = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{key_path}",
      "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
      "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
    ].join(" ")

    # Archive unsigned: a signed archive needs a development profile, which Apple only issues
    # when the team has a registered device. Signing happens at export with a cloud-managed
    # App Store distribution certificate, which needs no device.
    root = File.expand_path("..", __dir__)
    archive = "#{root}/build/App.xcarchive"
    export_dir = "#{root}/build/export"
    sh("set -o pipefail && cd #{root} && xcodebuild -project #{PROJECT} -scheme App -configuration Release " \
       "-destination 'generic/platform=iOS' -archivePath #{archive} DEVELOPMENT_TEAM=#{team} " \
       "CODE_SIGN_STYLE=Automatic CODE_SIGNING_ALLOWED=NO clean archive | xcbeautify")

    options = "#{root}/build/ExportOptions.plist"
    File.write(options, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0"><dict>
        <key>method</key><string>app-store-connect</string>
        <key>teamID</key><string>#{team}</string>
        <key>signingStyle</key><string>automatic</string>
        <key>uploadSymbols</key><true/>
      </dict></plist>
    PLIST
    sh("set -o pipefail && xcodebuild -exportArchive -archivePath #{archive} -exportPath #{export_dir} " \
       "-exportOptionsPlist #{options} #{auth} | xcbeautify")

    ipa = Dir["#{export_dir}/*.ipa"].first || UI.user_error!("Export produced no .ipa")
    # Log which certificate signed the app (expect "Apple Distribution").
    sh("cd #{root}/build && rm -rf ipa && unzip -oq '#{ipa}' -d ipa && codesign -dvv ipa/Payload/*.app 2>&1 | grep -E 'Authority|TeamIdentifier' | head -3")

    if ENV["UPLOAD"] == "true"
      upload_to_testflight(api_key: api_key, ipa: ipa, skip_waiting_for_build_processing: true)
    else
      UI.success("Signed .ipa ready (upload skipped): #{ipa}")
    end
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
  end
end
